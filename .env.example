# QuizStep Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local to version control.

# Supabase Public Credentials (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Site URL (used in sitemap, meta tags, etc.)
NEXT_PUBLIC_SITE_URL=https://your-site.workers.dev

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Server-only secrets (Never prefix with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=

